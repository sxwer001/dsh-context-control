{
  "name": "dsh-context-control",
  "version": "0.1.2",
  "description": "Context occupancy ring, configurable character thresholds and recoverable compaction for DeepSeek Harness.",
  "repository": { "type": "git", "url": "git+https://github.com/sxwer001/dsh-context-control.git" },
  "homepage": "https://github.com/sxwer001/dsh-context-control#readme",
  "bugs": { "url": "https://github.com/sxwer001/dsh-context-control/issues" },
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.19", "dsh": "0.2.0-rc.2" },
  "keywords": ["dsh-plugin", "deepseek-harness", "context", "compaction"],
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "zod": "4.6.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/dsh-util-values": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "zod": { "optional": true }
  },
  "exports": { ".": "./src/host.js", "./client": "./src/client.js", "./package.json": "./package.json" },
  "files": ["src", "vendor", "icon.svg", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "screenshots.json", "screenshots/dsh-native-context-control-quiet.jpg"],
  "icon": "./icon.svg",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale"] } },
  "scripts": { "check": "node scripts/check.mjs", "test": "node --test test/*.test.mjs", "test:integration": "node --test test/integration.test.mjs", "prepare:runtime": "node scripts/prepare-runtime.mjs", "pack:checked": "npm run check && npm test && npm pack" }
}
